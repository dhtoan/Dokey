#include <winres.h>
#include "../src/resource.h"
#include "version.h"

IDI_DOKEY ICON "dokey.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DOKEY_VER_MAJOR,DOKEY_VER_MINOR,DOKEY_VER_PATCH,0
 PRODUCTVERSION DOKEY_VER_MAJOR,DOKEY_VER_MINOR,DOKEY_VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Do Huy Toan"
            VALUE "FileDescription", "Dokey - Vietnamese input method"
            VALUE "FileVersion", DOKEY_APP_VERSION
            VALUE "InternalName", "Dokey"
            VALUE "LegalCopyright", "Copyright (c) 2026 Do Huy Toan"
            VALUE "OriginalFilename", "Dokey.exe"
            VALUE "ProductName", "Dokey"
            VALUE "ProductVersion", DOKEY_APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
